// The Worker and its workerd tests. Type-check only: wrangler bundles the sources.
{
  "extends": "../../cloudflare-os/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src", "__tests__/*.ts"],
  "exclude": ["node_modules", ".wrangler", "dist-app"]
}
