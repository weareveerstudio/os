// The Worker. Type-check only: wrangler bundles the sources. `capnweb-validate build` reads this
// file too, so it covers `src` alone; the workerd tests are in tsconfig.test.json.
{
  "extends": "../../cloudflare-os/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src"],
  "exclude": ["node_modules", ".wrangler", "dist-app"]
}
