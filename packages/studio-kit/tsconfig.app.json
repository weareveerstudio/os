// The app shell (browser code) and its jsdom tests.
{
  "compilerOptions": {
    // Standalone config (no extends): mirror the submodule root's singleThreaded.
    "singleThreaded": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["app", "__tests__/app"]
}
